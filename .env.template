# Configuración para Cartera Financiera
# Copiar a .env y ajustar valores específicos

# Flask configuration
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-here-change-in-production

# Database configuration (MySQL existente - mantener como está)
DATABASE_URL=mysql+pymysql://root@localhost/CarteraFinanciera?unix_socket=/opt/lampp/var/mysql/mysql.sock

# Cache configuration (opcional - para mejorar performance)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cartera.log

# File uploads
UPLOAD_FOLDER=uploads

# Email configuration (para reportes automáticos - opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# External APIs (para cotizaciones en tiempo real - opcional)
ALPHA_VANTAGE_API_KEY=your-api-key
FINNHUB_API_KEY=your-api-key
IEX_CLOUD_API_KEY=your-api-key

# phpMyAdmin configuration (para backups automáticos - opcional)
PHPMYADMIN_HOST=localhost
PHPMYADMIN_PORT=3306
PHPMYADMIN_USER=root
PHPMYADMIN_PASSWORD=your-mysql-password

# Backup configuration (opcional)
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM