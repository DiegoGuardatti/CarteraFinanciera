# Configuración para Cartera Financiera con Docker
# Copiar a .env y ajustar valores específicos

# Flask configuration
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-here-change-in-production

# Database configuration para Docker
DB_HOST=db
DB_PORT=3306
DB_USER=cartera_user
DB_PASSWORD=cartera_password
DB_NAME=CarteraFinanciera
MYSQL_ROOT_PASSWORD=root_password

# Cache configuration
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cartera.log

# File uploads
UPLOAD_FOLDER=uploads

# Inicialización de datos (solo para desarrollo)
INIT_DATA=true

# Email configuration (para reportes automáticos - opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# External APIs (para cotizaciones en tiempo real - opcional)
ALPHA_VANTAGE_API_KEY=your-api-key
FINNHUB_API_KEY=your-api-key
IEX_CLOUD_API_KEY=your-api-key

# Backup configuration (opcional)
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM